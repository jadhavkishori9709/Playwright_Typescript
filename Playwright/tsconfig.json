{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "./",
        "baseUrl": "./",
        "paths": {
            "@pages/*": [
                "pages/*"
            ],
            "@utils/*": [
                "utils/*"
            ],
            "@tests/*": [
                "tests/*"
            ]
        },
        "types": [
            "node",
            "@playwright/test"
        ]
    },
    "include": [
        "tests/**/*",
        "pages/**/*",
        "utils/**/*",
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "playwright-report",
        "test-results"
    ]
}