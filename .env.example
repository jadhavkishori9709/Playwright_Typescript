# Base URL for the application
BASE_URL=https://dev.giftsai.com/

# Anthropic Claude API Key (for AI-powered test generation)
ANTHROPIC_API_KEY=your_api_key_here

# Test user credentials (optional - for existing user tests)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Email service configuration (for email verification testing)
# Options: mock, mailosaur, etc.
EMAIL_SERVICE=mock

# Headless mode
HEADLESS=true

# Browser timeout (ms)
TIMEOUT=30000
